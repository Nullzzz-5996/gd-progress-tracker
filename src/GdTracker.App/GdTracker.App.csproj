<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GdTracker.ViewModels\GdTracker.ViewModels.csproj" />
    <ProjectReference Include="..\GdTracker.Core\GdTracker.Core.csproj" />
    <ProjectReference Include="..\GdTracker.Data\GdTracker.Data.csproj" />
    <ProjectReference Include="..\GdTracker.GameSync\GdTracker.GameSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 target platform so SkiaSharp.Views.WPF resolves its
         net8.0-windows10.0.19041 asset (OpenTK 4.x) instead of falling back to
         the .NET Framework asset (OpenTK 3.x), which triggered NU1701. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
