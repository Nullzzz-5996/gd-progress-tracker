<!--
    Неоновая тема: тёмно-фиолетовый синтвейв с фуксией в качестве акцента.

    Словарь подмешивается в ресурсы приложения ПОСЛЕ словаря WPF-UI (см. ThemeService),
    поэтому переопределённые здесь ключи самой WPF-UI выигрывают у стандартных: все
    контролы читают их через DynamicResource и перекрашиваются сами. Тёмная и светлая
    темы таких переопределений не содержат — при переключении этот словарь просто
    убирается, и WPF-UI возвращается к своим цветам.

    Палитра: фон #160B2E (тот же, что у экрана загрузки), подложки от #0D0221 до #2C1861,
    пурпур #C77DFF (рамки, разделители), фуксия #FF61D8 (акцент), голубой #01CDFE (сферы).

    Набор ключей приложения (нижняя половина файла) — см. Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Переопределения WPF-UI: оболочка ============ -->

    <!-- Фон окна и сплошные подложки -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF160B2E" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF160B2E" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#FF0D0221" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF1B0F38" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF241350" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF2C1861" />

    <!-- Слои поверх фона (панель навигации, всплывающие поверхности) -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#663A1D6E" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#14C77DFF" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#7A241350" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="#4C2C1861" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="#FF1B0F38" />

    <!-- Карточки WPF-UI -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#26C77DFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1AC77DFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#59C77DFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF3A1D6E" />

    <!-- Кнопки, поля ввода, списки -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1FFF61D8" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#33FF61D8" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#14FF61D8" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF241350" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#FF241350" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#59C77DFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#40C77DFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#99C77DFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#26FF61D8" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#14FF61D8" />

    <!-- Текст -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF2E9FF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D8E0CCFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A6D6BFFF" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#99C0A8E0" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#FFFF61D8" />
    <!-- Текст поверх акцентной заливки: на фуксии читается тёмный -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF16062B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#C416062B" />

    <!-- Акцент: фуксия вместо системного синего -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF61D8" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF61D8" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFF8BE4" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#FFE84FC4" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#FFC77DFF" />

    <!-- Выделение: индикатор пункта навигации и выбранная строка списка -->
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#3DFF61D8" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#FFF2E9FF" />

    <!-- Фокус клавиатуры -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="#FFFF61D8" />

    <!-- Разделители и рамки -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#40C77DFF" />
    <SolidColorBrush x:Key="SeparatorBorderBrush" Color="#40C77DFF" />
    <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="#40C77DFF" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#40C77DFF" />
    <SolidColorBrush x:Key="NavigationViewItemBorderBrush" Color="#00FFFFFF" />

    <!-- Индикаторы прогресса -->
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#FFFF61D8" />
    <SolidColorBrush x:Key="ProgressRingBackgroundThemeBrush" Color="#40C77DFF" />
    <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="#00FFFFFF" />

    <!-- ============ Ключи приложения (набор одинаков во всех темах) ============ -->

    <!-- Фон главного окна. Непрозрачный: перекрывает системный материал Mica,
         иначе окно осталось бы серым, а неоновой была бы только фурнитура. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF160B2E" />

    <!-- Карточки статистики -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#405B3FA6" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#99C77DFF" />

    <!-- Акценты сводки аккаунта -->
    <SolidColorBrush x:Key="StarsAccentBrush" Color="#FF61D8" />
    <SolidColorBrush x:Key="MoonsAccentBrush" Color="#C77DFF" />
    <SolidColorBrush x:Key="DemonsAccentBrush" Color="#FF2E92" />
    <SolidColorBrush x:Key="CoinsAccentBrush" Color="#40C9FF" />
    <SolidColorBrush x:Key="OrbsAccentBrush" Color="#01CDFE" />

    <!-- Акценты сводки прогресса в трекере -->
    <SolidColorBrush x:Key="CompletedAccentBrush" Color="#6EE7F5" />
    <SolidColorBrush x:Key="InProgressAccentBrush" Color="#FF8BD1" />

    <!-- Предупреждающие сообщения -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FF4D8D" />

    <!-- Экран загрузки -->
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#FF160B2E" />
    <SolidColorBrush x:Key="SplashTitleBrush" Color="#FFC77DFF" />
    <SolidColorBrush x:Key="SplashSubtitleBrush" Color="#FF8F7BB8" />

</ResourceDictionary>
