<!--
    Неоновая тема: тёмно-фиолетовый синтвейв. Фон карточки — тот же приём, что
    в тёмной теме (полупрозрачная заливка поверх тёмной базы WPF-UI), но с
    фиолетовым оттенком вместо белого. Рамка — пурпурная. Акценты — в
    розово-голубой гамме.

    Набор ключей — см. Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Карточки статистики -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#405B3FA6" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#99C77DFF" />

    <!-- Акценты сводки аккаунта -->
    <SolidColorBrush x:Key="StarsAccentBrush" Color="#FF61D8" />
    <SolidColorBrush x:Key="MoonsAccentBrush" Color="#C77DFF" />
    <SolidColorBrush x:Key="DemonsAccentBrush" Color="#FF2E92" />
    <SolidColorBrush x:Key="CoinsAccentBrush" Color="#40C9FF" />
    <SolidColorBrush x:Key="OrbsAccentBrush" Color="#01CDFE" />

    <!-- Акценты сводки прогресса в трекере -->
    <SolidColorBrush x:Key="CompletedAccentBrush" Color="#6EE7F5" />
    <SolidColorBrush x:Key="InProgressAccentBrush" Color="#FF8BD1" />

    <!-- Предупреждающие сообщения -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FF4D8D" />

    <!-- Экран загрузки -->
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#FF160B2E" />
    <SolidColorBrush x:Key="SplashTitleBrush" Color="#FFC77DFF" />
    <SolidColorBrush x:Key="SplashSubtitleBrush" Color="#FF8F7BB8" />

</ResourceDictionary>
