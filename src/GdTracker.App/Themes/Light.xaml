<!--
    Светлая тема. Фон карточки — плотный светло-серый (не полупрозрачный белый:
    на светлом фоне полупрозрачная белая заливка сливается с страницей и
    карточки становятся не видны). Рамка карточки — заметная, непрозрачная.
    Акценты, которые в тёмной теме были жёлтыми/голубыми (плохо читаются на
    белом), заменены на более тёмные оттенки тех же тонов.

    Набор ключей — см. Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Фон главного окна. Прозрачный: сквозь него виден системный материал Mica,
         как было до появления этого ключа. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#00000000" />

    <!-- Карточки статистики -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFE7E7EC" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFB0B0B8" />

    <!-- Акценты сводки аккаунта -->
    <SolidColorBrush x:Key="StarsAccentBrush" Color="#C9971C" />
    <SolidColorBrush x:Key="MoonsAccentBrush" Color="#7E57C2" />
    <SolidColorBrush x:Key="DemonsAccentBrush" Color="#C62828" />
    <SolidColorBrush x:Key="CoinsAccentBrush" Color="#B8860B" />
    <SolidColorBrush x:Key="OrbsAccentBrush" Color="#00838F" />

    <!-- Акценты сводки прогресса в трекере -->
    <SolidColorBrush x:Key="CompletedAccentBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="InProgressAccentBrush" Color="#B26A00" />

    <!-- Предупреждающие сообщения -->
    <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />

    <!-- Экран загрузки -->
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="SplashTitleBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SplashSubtitleBrush" Color="#FF70707A" />

</ResourceDictionary>
