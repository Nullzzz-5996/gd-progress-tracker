<ui:FluentWindow x:Class="GdTracker.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:GdTracker.App.Views"
                 Title="GD Progress Tracker"
                 Width="1100" Height="720"
                 MinWidth="800" MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Icon="pack://application:,,,/Assets/app.ico">
    <!-- Фон задан корневой сетке, а не окну: WPF-UI при включённом материале Mica
         сам сбрасывает Background окна в прозрачный. В тёмной и светлой темах кисть
         прозрачна и Mica виден как прежде, в неоновой — закрывает его собой. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GD Progress Tracker">
            <!-- Иконку в заголовке WPF-UI берёт не из Window.Icon, её нужно задать явно. -->
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Уровни"
                                       TargetPageType="{x:Type views:DashboardPage}" />
                <ui:NavigationViewItem Content="Прогрессы"
                                       TargetPageType="{x:Type views:ProgressesPage}" />
                <ui:NavigationViewItem Content="Статистика"
                                       TargetPageType="{x:Type views:StatsPage}" />
                <ui:NavigationViewItem Content="Поиск онлайн"
                                       TargetPageType="{x:Type views:OnlineSearchPage}" />
                <ui:NavigationViewItem Content="CPS"
                                       TargetPageType="{x:Type views:CpsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Настройки"
                                       TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
