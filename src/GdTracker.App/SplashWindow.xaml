<Window x:Class="GdTracker.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GD Progress Tracker"
        Width="480" Height="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SplashBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок и подпись автора -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="GD Progress Tracker"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SplashTitleBrush}" />
            <TextBlock Text="By: Nullzzz"
                       FontSize="14"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       Opacity="0.85"
                       Foreground="{DynamicResource SplashSubtitleBrush}" />
        </StackPanel>

        <!-- Полоса загрузки: анимируется непрерывно (IsIndeterminate), т.к. реальные
             этапы запуска занимают доли секунды и не дают осмысленного процента —
             какой этап сейчас идёт, показывает подпись ниже. -->
        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="1"
                     Height="4"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource InProgressAccentBrush}"
                     Margin="0,0,0,10" />

        <!-- Подпись текущего этапа: обновляется из App.OnStartup по мере прохождения
             реальных этапов инициализации. -->
        <TextBlock x:Name="StageText"
                   Grid.Row="2"
                   Text="Инициализация..."
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SplashSubtitleBrush}" />
    </Grid>
</Window>
