<!-- Цвет текста страницы задан явно (TextElement.Foreground): неявный стиль TextBlock
     из WPF-UI задаёт только шрифт, поэтому обычные TextBlock оставались чёрными по
     умолчанию WPF и сливались с фоном в тёмной и неоновой темах. -->
<Page x:Class="GdTracker.App.Views.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="AccountPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Значок роли рядом с ником. У обычного участника он приглушён,
             у модератора и администратора — подсвечен акцентным цветом темы. -->
        <Style x:Key="RoleBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrivilegedRole}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" VerticalAlignment="Top" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Аккаунт" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="Аккаунт нужен только для синхронизации прогресса между компьютерами. Без него приложение работает полностью: данные хранятся локально, ничего никуда не отправляется." />

            <!-- Адрес сервера: единого публичного сервера у проекта нет, каждый поднимает свой. -->
            <TextBlock Margin="0,20,0,4" Text="Адрес сервера синхронизации" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" />
                <!-- Проверка до регистрации: чаще всего «не проходит регистрация»
                     означает, что по этому адресу просто некому отвечать. -->
                <Button Grid.Column="1" Margin="8,0,0,0" Content="Проверить сервер"
                        Command="{Binding CheckServerCommand}" IsEnabled="{Binding IsIdle}" />
            </Grid>
            <TextBlock Margin="0,4,0,0" Opacity="0.6" TextWrapping="Wrap"
                       Text="Регистрация и вход идут на этот сервер. Свой локальный поднимается командой «powershell -File tools/run-sync-server.ps1» в папке проекта." />

            <!-- Форма входа: видна, пока пользователь не вошёл -->
            <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,16,0,4" Text="Ник" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                <TextBlock Margin="0,4,0,0" Opacity="0.6" TextWrapping="Wrap"
                           Text="Вход идёт по нику. От 3 до 20 символов: буквы, цифры, дефис и подчёркивание. Под этим именем аккаунт виден в демонлисте." />
                <TextBlock Margin="0,12,0,4" Text="Почта (нужна для регистрации)" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,0" Opacity="0.6" TextWrapping="Wrap"
                           Text="При входе поле можно не заполнять — но если ник забылся, войти можно и по почте." />
                <TextBlock Margin="0,12,0,4" Text="Пароль" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                <TextBlock Margin="0,4,0,0" Opacity="0.6" TextWrapping="Wrap"
                           Text="Не короче 8 символов. Пароль уходит на сервер только для входа и хранится там в виде хеша." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Войти" Command="{Binding SignInCommand}" IsEnabled="{Binding IsIdle}" />
                    <Button Content="Зарегистрироваться" Margin="8,0,0,0" Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsIdle}" />
                </StackPanel>
            </StackPanel>

            <!-- Панель вошедшего пользователя -->
            <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                <!-- Ник и рядом с ним роль: так же, как аккаунт выглядит в демонлисте. -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="{Binding AccountUsername}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    <Border Style="{StaticResource RoleBadge}">
                        <TextBlock Text="{Binding AccountRoleLabel}" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="{Binding AccountEmail}" />
                <TextBlock Margin="0,2,0,0" Opacity="0.7" Text="{Binding LastSyncText}" />

                <TextBlock Margin="0,14,0,4" Opacity="0.7" Text="Сменить ник" />
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                    <TextBox Width="240" MaxLength="20" VerticalContentAlignment="Center"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Сохранить ник" Margin="8,0,0,0" Command="{Binding ChangeUsernameCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
                    <Button Content="Синхронизировать" Command="{Binding SyncCommand}" />
                    <Button Content="Загрузить из облака" Margin="8,0,0,0" Command="{Binding PullCommand}" />
                    <Button Content="Отправить в облако" Margin="8,0,0,0" Command="{Binding PushCommand}" />
                </StackPanel>

                <CheckBox Margin="0,14,0,0" Content="Синхронизировать при запуске приложения"
                          IsChecked="{Binding AutoSyncOnStartup}" />

                <TextBlock Margin="0,20,0,4" Opacity="0.7" TextWrapping="Wrap"
                           Text="Опасная зона. Локальная база при этих действиях не трогается." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Выйти" Command="{Binding SignOutCommand}" />
                    <Button Content="Удалить копию в облаке" Margin="8,0,0,0" Command="{Binding DeleteCloudDataCommand}" />
                    <Button Content="Удалить аккаунт" Margin="8,0,0,0" Command="{Binding DeleteAccountCommand}" />
                </StackPanel>

                <!-- Пароль нужен ещё раз для удаления аккаунта: одного токена мало. -->
                <TextBlock Margin="0,12,0,4" Opacity="0.6" TextWrapping="Wrap"
                           Text="Для удаления аккаунта введи пароль:" />
                <PasswordBox x:Name="ConfirmPasswordInput" PasswordChanged="OnPasswordChanged" MaxWidth="300"
                             HorizontalAlignment="Left" />
            </StackPanel>

            <ui:ProgressRing Margin="0,16,0,0" IsIndeterminate="True" HorizontalAlignment="Left"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.85" Text="{Binding Status}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="IndianRed" Text="{Binding Error}" />
        </StackPanel>
    </ScrollViewer>
</Page>
