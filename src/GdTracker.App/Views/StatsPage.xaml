<!-- Цвет текста страницы задан явно (TextElement.Foreground): неявный стиль TextBlock
     из WPF-UI задаёт только шрифт, поэтому обычные TextBlock оставались чёрными по
     умолчанию WPF и сливались с фоном в тёмной и неоновой темах. -->
<Page x:Class="GdTracker.App.Views.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="StatsPage">
    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Статистика" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- Аккаунт: данные из сейв-файла игры, не зависят от таблицы уровней -->
            <TextBlock Text="Аккаунт" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Обновить" Command="{Binding RefreshAccountCommand}" Margin="0,0,8,0" />
                <Button Content="Указать файл" Command="{Binding PickSaveFileCommand}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding AccountUpdatedAt}" Opacity="0.6" VerticalAlignment="Center" />
                <TextBlock Text="Обновление…" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAccountBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="{Binding AccountStatus}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AccountStatus}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <WrapPanel>
                <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAccountStats}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Style>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountStars}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource StarsAccentBrush}" />
                        <TextBlock Text="Звёзды" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountMoons}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource MoonsAccentBrush}" />
                        <TextBlock Text="Луны" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountDemons}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DemonsAccentBrush}" />
                        <TextBlock Text="Демоны" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountOnlineLevels}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Онлайн-уровни" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountOfficialLevels}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Официальные уровни" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountSecretCoins}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CoinsAccentBrush}" />
                        <TextBlock Text="Секретные монеты" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountAttempts}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Попытки" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountJumps}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Прыжки" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountTotalOrbs}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource OrbsAccentBrush}" />
                        <TextBlock Text="Сферы (всего)" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Динамика: звёзды по левой оси, демоны по правой (различаются в десятки раз) -->
            <TextBlock Text="Динамика звёзд и демонов" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <lvc:CartesianChart Series="{Binding TrendSeries}"
                                XAxes="{Binding TrendXAxes}"
                                YAxes="{Binding TrendYAxes}"
                                Height="260"
                                Background="Transparent"
                                LegendTextPaint="{Binding ChartLegendPaint}"
                                LegendPosition="Top" />

            <!-- Прогресс в трекере: данные из БД приложения -->
            <TextBlock Text="Прогресс в трекере" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />

            <TextBlock Text="{Binding TrackerStatus}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TrackerStatus}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Сводные карточки -->
            <WrapPanel>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalLevels}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Всего уровней" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Completed}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CompletedAccentBrush}" />
                        <TextBlock Text="Пройдено" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding InProgress}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InProgressAccentBrush}" />
                        <TextBlock Text="В процессе" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Untouched}" FontSize="26" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock Text="Не начато" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalAttempts}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Всего попыток" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding OfficialProgress}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Официальные пройдены" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Завершённость -->
            <TextBlock Text="Завершённость" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <lvc:PieChart Series="{Binding CompletionSeries}" Height="260" Background="Transparent"
                          LegendTextPaint="{Binding ChartLegendPaint}"
                          LegendPosition="Right" />

            <!-- Распределение по лучшему normal % -->
            <TextBlock Text="Распределение по лучшему проценту (normal)" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <lvc:CartesianChart Series="{Binding BucketSeries}" XAxes="{Binding BucketXAxes}" Height="260"
                                Background="Transparent" />

            <!-- Топ по попыткам -->
            <TextBlock Text="Топ уровней по попыткам" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <lvc:CartesianChart Series="{Binding TopAttemptsSeries}" XAxes="{Binding TopXAxes}" Height="320"
                                Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</Page>
