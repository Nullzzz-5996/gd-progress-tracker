<Page x:Class="GdTracker.App.Views.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="StatsPage">
    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Статистика" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- Сводные карточки -->
            <WrapPanel>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalLevels}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Всего уровней" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Completed}" FontSize="26" FontWeight="Bold" Foreground="#4CAF50" />
                        <TextBlock Text="Пройдено" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding InProgress}" FontSize="26" FontWeight="Bold" Foreground="#FFC107" />
                        <TextBlock Text="В процессе" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Untouched}" FontSize="26" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock Text="Не начато" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalAttempts}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Всего попыток" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding OfficialProgress}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Официальные пройдены" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Завершённость -->
            <TextBlock Text="Завершённость" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <lvc:PieChart Series="{Binding CompletionSeries}" Height="260" LegendPosition="Right" />

            <!-- Распределение по лучшему normal % -->
            <TextBlock Text="Распределение по лучшему проценту (normal)" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <lvc:CartesianChart Series="{Binding BucketSeries}" XAxes="{Binding BucketXAxes}" Height="260" />

            <!-- Топ по попыткам -->
            <TextBlock Text="Топ уровней по попыткам" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <lvc:CartesianChart Series="{Binding TopAttemptsSeries}" XAxes="{Binding TopXAxes}" Height="320" />
        </StackPanel>
    </ScrollViewer>
</Page>
