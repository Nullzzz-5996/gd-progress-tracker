<Page x:Class="GdTracker.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:GdTracker.ViewModels;assembly=GdTracker.ViewModels"
      xmlns:conv="clr-namespace:GdTracker.App.Converters"
      Title="DashboardPage">

    <Page.Resources>
        <conv:DetailPaneWidthConverter x:Key="DetailWidth" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Уровни" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- Данные: импорт из игры + обмен файлами -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Импорт из игры" Command="{Binding ImportFromGameCommand}" />
            <TextBox Width="330" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     Text="{Binding SaveFilePath, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Путь к CCGameManager.dat" />
            <Button Content="Экспорт" Command="{Binding ExportCommand}" Margin="8,0,0,0" />
            <Button Content="Импорт из файла" Command="{Binding ImportFromFileCommand}" Margin="8,0,0,0" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.85"
                       Text="{Binding ImportStatus}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
        </StackPanel>

        <!-- Добавление уровня -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="260" Text="{Binding NewLevelName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" ToolTip="Название уровня" />
            <ComboBox Width="130" Margin="8,0,0,0" ItemsSource="{Binding Sources}" SelectedItem="{Binding NewLevelSource}" />
            <TextBox Width="110" Margin="8,0,0,0" Text="{Binding NewLevelGdId, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center" ToolTip="ID уровня в игре (необязательно)" />
            <Button Margin="8,0,0,0" Content="Добавить уровень" Command="{Binding AddLevelCommand}" />
            <Button Margin="8,0,0,0" Content="Удалить уровень" Command="{Binding DeleteCurrentLevelCommand}"
                    IsEnabled="{Binding HasSelection}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="IndianRed" Text="{Binding Error}" />
        </StackPanel>

        <!-- Фильтр + групповые операции -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBox Width="300" PlaceholderText="Фильтр: имя, создатель, сложность, ID"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="8,0,0,0" Content="Выделить всё" Command="{Binding SelectAllCommand}" />
            <Button Margin="8,0,0,0" Content="Снять выделение" Command="{Binding ClearSelectionCommand}" />
            <Button Margin="8,0,0,0" Command="{Binding DeleteSelectedCommand}"
                    Content="{Binding SelectedCount, StringFormat='Удалить выбранные ({0})'}" />
        </StackPanel>

        <!-- Master-detail -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="420" />
                <!-- Разделитель и деталь схлопываются, пока уровень не выбран:
                     иначе пустая панель съедала бы больше половины ширины окна. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding Detail, Converter={StaticResource DetailWidth}}" />
            </Grid.ColumnDefinitions>

            <!-- Список уровней -->
            <DataGrid Grid.Column="0"
                      x:Name="LevelsGrid"
                      ItemsSource="{Binding Levels}"
                      SelectedItem="{Binding SelectedRow}"
                      SelectionMode="Extended"
                      SelectionChanged="OnLevelsSelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Уровень" Binding="{Binding Level.Name}" Width="*" />
                    <DataGridTextColumn Header="Сложность" Binding="{Binding Level.Difficulty}" Width="Auto" />
                    <DataGridTextColumn Header="Создатель" Binding="{Binding Level.Creator}" Width="Auto" />
                    <DataGridTextColumn Header="★" Binding="{Binding Level.Stars}" Width="Auto" />
                    <DataGridTextColumn Header="Norm%" Binding="{Binding Level.BestNormalPercent}" Width="Auto" />
                    <DataGridTextColumn Header="Pract%" Binding="{Binding Level.BestPracticePercent}" Width="Auto" />
                    <DataGridTextColumn Header="Попыт." Binding="{Binding Level.TotalAttempts}" Width="Auto" />
                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding Level.IsCompleted}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding Detail, Converter={StaticResource NotNullToVisibility}}" />

            <!-- Деталь выбранного уровня -->
            <ContentControl Grid.Column="2" Content="{Binding Detail}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:LevelDetailViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Level.Name}" FontSize="20" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Level.Difficulty}" Margin="0,0,16,0" Opacity="0.85" />
                                    <TextBlock Text="{Binding Level.Creator, StringFormat='by {0}'}" Margin="0,0,16,0" Opacity="0.85" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Level.BestNormalPercent, StringFormat='Normal: {0}%'}" Margin="0,0,16,0" />
                                    <TextBlock Text="{Binding Level.BestPracticePercent, StringFormat='Practice: {0}%'}" Margin="0,0,16,0" />
                                    <TextBlock Text="{Binding Level.TotalAttempts, StringFormat='Попытки: {0}'}" Margin="0,0,16,0" />
                                    <TextBlock Text="{Binding Level.IsCompleted, StringFormat='Пройден: {0}'}" />
                                </StackPanel>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Records}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}" Width="Auto" />
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="Auto" />
                                    <DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="Auto" />
                                    <DataGridTextColumn Header="С %" Binding="{Binding StartPercent}" Width="Auto" />
                                    <DataGridTextColumn Header="До %" Binding="{Binding ReachedPercent}" Width="Auto" />
                                    <DataGridTextColumn Header="Попытки" Binding="{Binding Attempts}" Width="Auto" />
                                    <DataGridTextColumn Header="Заметка" Binding="{Binding Note}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.DeleteProgressCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="#33888888">
                                <StackPanel>
                                    <TextBlock Text="Добавить прогресс" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="Тип" />
                                            <ComboBox Width="120" ItemsSource="{Binding RunTypes}" SelectedItem="{Binding NewRunType}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="Режим" />
                                            <ComboBox Width="110" ItemsSource="{Binding Modes}" SelectedItem="{Binding NewMode}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="С %" />
                                            <TextBox Width="70" Text="{Binding NewStartPercent}" IsEnabled="{Binding IsSegment}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="До %" />
                                            <TextBox Width="70" Text="{Binding NewReachedPercent}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="Попытки" />
                                            <TextBox Width="80" Text="{Binding NewAttempts, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="Заметка" />
                                            <TextBox Width="220" Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="Добавить прогресс" Command="{Binding AddProgressCommand}" />
                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="IndianRed"
                                                   Text="{Binding FormError}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Page>
