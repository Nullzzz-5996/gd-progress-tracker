<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Контракты API и переносимый пакет прогресса общие с клиентом. -->
    <ProjectReference Include="..\GdTracker.Sharing\GdTracker.Sharing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Стартовая расстановка демонлиста: снимок глобального списка, вложенный
         в сборку, чтобы сервер наполнял пустую базу без обращения в сеть. -->
    <EmbeddedResource Include="Data\Seed\demonlist-seed.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- Та же заплатка нативного SQLite, что и в GdTracker.Data (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Класс Program нужен интеграционным тестам (WebApplicationFactory<Program>). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
