<Project>

  <!-- Общие свойства для всех проектов решения GdTracker -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Сборка только x64 (требование ScreenRecorderLib и чтения памяти, Фазы 5-6) -->
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <!-- Единая версия продукта для всех сборок. Показывается на странице «Настройки»:
         SettingsViewModel читает версию через GetExecutingAssembly() (сборка ViewModels),
         поэтому версия должна стоять здесь, а не только в проекте приложения. -->
    <Version>1.0.1.1</Version>
  </PropertyGroup>

</Project>
